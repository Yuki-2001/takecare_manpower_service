cat > .gitignore <<'EOF'
# ================================
# OS / IDE
# ================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Eclipse / STS
.metadata/
.settings/
.classpath
.project
.factorypath

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr


# ================================
# Java / Spring Boot
# ================================

target/
*.class
*.jar
*.war
*.ear

# Maven
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar


# ================================
# Node.js / Frontend
# ================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
.nuxt/
.output/

# Coverage
coverage/
.nyc_output/


# ================================
# Environment / Secrets
# ================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt

# ================================
# Logs
# ================================

*.log
logs/


# ================================
# Temporary files
# ================================

*.tmp
*.temp
*.swp
*.swo
*~
EOF
